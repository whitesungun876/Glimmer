# Glimmer API — 邀请、能量、Daily Spark 等
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/glimmer

# Daily Spark：1. LLM 总结（千问） 2. 文生图（万相）
#
# 注意：不要把真实 API Key 写进 .env.example / 代码仓库。请在 server/.env 中配置。
DASHSCOPE_API_KEY=sk-...
# LLM 走 OpenAI 兼容模式（推荐填这个；若不填，代码在仅使用 DASHSCOPE_API_KEY 时也会默认该值）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文生图（万相）会自动从 DASHSCOPE_BASE_URL 推导根域名，一般无需配置；如需手动指定可用：
# DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_MODEL=qwen-turbo  # 或 qwen-plus 等


